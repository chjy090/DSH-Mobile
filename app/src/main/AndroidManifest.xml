<?xml version="1.0" encoding="utf-8"?>
<!-- DSH Mobile v0.4.5（versionCode 12）：App 内「最近下载」兜底；下载按 MIME 分流到 Pictures/Movies/Music，文档仍在 Download；Q+ 补一次媒体扫描；WebView/配对/菜单能力延续 v0.4.4。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v0.4.0 扫码配对：CameraX 取景 + ML Kit 二维码识别（运行时权限）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 扫码成功震动一次（普通权限，无运行时弹窗）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音输入：WebView 页面的 getUserMedia/MediaRecorder 需要原生 RECORD_AUDIO。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音输入（v0.2.0 起）：WebView 页面请求带 echoCancellation / noiseSuppression 的
         getUserMedia 时，Chromium 需要选择“通信设备”；清单缺少此普通权限会报
         "Unable to select communication device!"，JS 侧表现为
         NotReadableError: Could not start audio source。普通权限，无运行时弹窗。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- API 28 及以下由 App 内下载器直接写公共 Downloads；29+ 经 MediaStore 写入，无需此权限。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 相机只是扫码可选项：无相机设备仍可安装，改用「手动输入 + 完整配对链接」之外的既有直连模式。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- v0.4.1：关闭预测性返回（predictive back）。返回手势/三键返回统一走
         Activity.onBackPressed → OnBackPressedDispatcher，由 MainActivity 的状态机决定
         收错误层/收键盘/网页后退/关菜单/弹「应用菜单」。 -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSHMobile"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.DSHMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v0.4.0 扫码配对：仅 App 内启动，竖屏，不对外导出。 -->
        <activity
            android:name=".QrScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DSHMobile" />

        <!-- v0.4.5「最近下载」：Android 8/9 用 FileProvider 打开公共 Download 下的文件；
             Android 10+ 直接使用 MediaStore content Uri。仅暴露 Download/，不导出。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
