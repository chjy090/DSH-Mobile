<?xml version="1.0" encoding="utf-8"?>
<!-- DSH Mobile v0.4.0（versionCode 7）：远程 dsh Web GUI 的 WebView 外壳 + 认证网关扫码配对。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v0.4.0 扫码配对：CameraX 取景 + ML Kit 二维码识别（运行时权限）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 扫码成功震动一次（普通权限，无运行时弹窗）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音输入：WebView 页面的 getUserMedia/MediaRecorder 需要原生 RECORD_AUDIO。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音输入（v0.2.0 起）：WebView 页面请求带 echoCancellation / noiseSuppression 的
         getUserMedia 时，Chromium 需要选择“通信设备”；清单缺少此普通权限会报
         "Unable to select communication device!"，JS 侧表现为
         NotReadableError: Could not start audio source。普通权限，无运行时弹窗。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- API 28 及以下由 App 内下载器直接写公共 Downloads；29+ 经 MediaStore 写入，无需此权限。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 相机只是扫码可选项：无相机设备仍可安装，改用「手动输入 + 完整配对链接」之外的既有直连模式。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSHMobile"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.DSHMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v0.4.0 扫码配对：仅 App 内启动，竖屏，不对外导出。 -->
        <activity
            android:name=".QrScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DSHMobile" />
    </application>

</manifest>
